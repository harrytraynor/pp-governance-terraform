# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Local backend config and plans. Examples are committed as *.example.
backend.hcl
plan.txt
plan-*.txt
plan-*.json
tfplan
*.tfplan
*.tfplan.json
*.out

# Local secrets. Never commit these.
.env
*.env

# Variable files can hold tenant ids. Commit only the examples.
*.tfvars
*.tfvars.json
!*.tfvars.example

# OS and editor noise
.DS_Store
*.swp
