# Copy to terraform.tfvars in this directory. terraform.tfvars is gitignored.
# Local authentication uses the Azure CLI. Do not put a client secret in this file.
use_cli  = true
use_oidc = false

# Uncomment if you are not using the CLI. The client secret stays in
# POWER_PLATFORM_CLIENT_SECRET, or you use a federated credential with use_oidc.
# tenant_id = "00000000-0000-0000-0000-000000000000"
# client_id = "00000000-0000-0000-0000-000000000000"

name_prefix = "ppgov"

# Leave false for the first plan. True creates a block-by-default data policy
# that applies only to the default environment.
manage_default_environment_dlp = false

# Routing stays off. After groups has been applied, either set the flag and the
# three backend names (the same values as backend.hcl) so this stack reads the
# sandbox group id, or paste that id below. New makers only.
route_new_makers_to_sandbox = false
# environment_routing_all_makers = false
# environment_routing_target_group_id = "00000000-0000-0000-0000-000000000000"
# backend_resource_group_name  = "rg-REPLACE-tfstate"
# backend_storage_account_name = "stREPLACE"
# backend_container_name       = "tfstate"
